# Отримати у Telegram @BotFather командою /newbot.
TELEGRAM_BOT_TOKEN=ВСТАВ_ТОКЕН_ВІД_BOTFATHER

# Варіант А: service account JSON, який НЕ завантажується до GitHub.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Варіант Б: якщо налаштовано gcloud auth application-default login,
# прибери GOOGLE_APPLICATION_CREDENTIALS повністю або залиш порожнім.

# Необов'язково. /id показує власний Telegram ID. Після тестування захисти бот:
# ALLOWED_TELEGRAM_USER_IDS=123456789
ALLOWED_TELEGRAM_USER_IDS=
